{
  "name": "trader-agent-userui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=../.env server.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src server.mjs config.mjs tests playwright.config.ts vite.config.ts tsconfig.json package.json index.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
