# Engine
ANTHROPIC_API_KEY=
ENGINE_API_KEY=
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
LOG_LEVEL=INFO

# Yerel client ve web'in bağlantı adresi. Uzak engine için gerçek adresi yazın.
# Compose kendi ağında bu adresi engine servisi ve ENGINE_PORT ile kurar.
ENGINE_URL=http://127.0.0.1:8000

# User UI — kullanıcı kaydı arayüzden yapılır
USERUI_HOST=127.0.0.1
USERUI_PORT=3000
USERUI_DATABASE_PATH=
# Cloud'da örn. https://trader.example.com; yerelde boş bırakılabilir
USERUI_ORIGIN=

# Göreli dizinler bu .env dosyasının konumuna göre çözülür.
TRADER_CONFIGS_DIR=./configs
TRADER_DATA_DIR=./data
TRADER_LOGS_DIR=./logs
